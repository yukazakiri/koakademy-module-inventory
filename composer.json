{
    "name": "koakademy/inventory",
    "description": "Property and inventory management for products, suppliers, stock, and borrowings.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "KoAkademy contributors"
        }
    ],
    "require": {
        "php": ">=8.5 <8.6",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "nwidart/laravel-modules": "^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Inventory\\": "app/",
            "Modules\\Inventory\\Database\\Factories\\": "database/factories/",
            "Modules\\Inventory\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Inventory\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Inventory\\Providers\\InventoryServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --compact tests/Unit/PackageContractTest.php"
    }
}
